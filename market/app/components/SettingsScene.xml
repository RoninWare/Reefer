<?xml version="1.0" encoding="utf-8" ?>
<!-- Rellie Reef: adapted from Reef Glass v1.1.3 (Apache-2.0). What changed is listed in NOTICE.md.
     Screensaver settings UI. Roku runs RunScreenSaverSettings in a context that only shows
     SceneGraph screens (an roScreen there never appears). Two radio lists, one above the other:
     the lighting and the season. Up and Down move through one list and on into the other. -->
<component name="SettingsScene" extends="Scene">
    <interface>
        <!-- The choices for each list, [{ id, label }], from source/settings.brs. -->
        <field id="lightingChoices" type="array" onChange="onLightingChoices" />
        <field id="seasonChoices" type="array" onChange="onSeasonChoices" />
        <!-- The chosen ids (see LightingChoices and SeasonChoices in source/settings.brs). -->
        <field id="lighting" type="string" onChange="onLightingSet" />
        <field id="season" type="string" onChange="onSeasonSet" />
        <field id="done" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="SettingsScene.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x06182AFF" />
        <Label translation="[160,90]" text="Seasons Reef tank" font="font:LargeBoldSystemFont" color="0xE6F2F5FF" />
        <Label translation="[160,170]" color="0x8FB3C2FF" font="font:SmallSystemFont"
            text="OK selects. Up and Down move between the lists. Back exits. Changes show the next time the screensaver starts." />
        <Label translation="[160,250]" text="Lighting in the tank" font="font:MediumBoldSystemFont" color="0xBFD9E2FF" />
        <RadioButtonList id="lighting" translation="[160,310]" itemSize="[1100,72]" itemSpacing="[0,8]"
            vertFocusAnimationStyle="floatingFocus" />
        <Label translation="[160,740]" text="Season" font="font:MediumBoldSystemFont" color="0xBFD9E2FF" />
        <RadioButtonList id="season" translation="[160,800]" itemSize="[1100,72]" itemSpacing="[0,8]"
            vertFocusAnimationStyle="floatingFocus" />
    </children>
</component>
