<?xml version="1.0" encoding="utf-8" ?>
<!-- Rellie Reef: adapted from Reef Glass v1.1.3 (Apache-2.0). What changed is listed in NOTICE.md.
     Screensaver settings UI. Roku runs RunScreenSaverSettings in a context that only shows
     SceneGraph screens. Up and Down move through the radio lists. -->
<component name="SettingsScene" extends="Scene">
    <interface>
        <!-- The choices for each list, [{ id, label }], from source/settings.brs. -->
        <field id="tankChoices" type="array" onChange="onTankChoices" />
        <field id="lightingChoices" type="array" onChange="onLightingChoices" />
        <field id="seasonChoices" type="array" onChange="onSeasonChoices" />
        <!-- The chosen ids (see LightingChoices and SeasonChoices in source/settings.brs). -->
        <field id="tank" type="string" onChange="onTankSet" />
        <field id="lighting" type="string" onChange="onLightingSet" />
        <field id="season" type="string" onChange="onSeasonSet" />
        <field id="settingsReady" type="boolean" onChange="onReady" />
        <field id="done" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="SettingsScene.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x06182AFF" />
        <Label translation="[160,66]" text="Rellie Reef" font="font:LargeBoldSystemFont" color="0xE6F2F5FF" />
        <Label translation="[160,137]" color="0x8FB3C2FF" font="font:SmallSystemFont"
            text="OK selects. Up and Down move between the lists. Back exits. Changes show the next time the screensaver starts." />
        <Label id="tankLabel" translation="[160,202]" text="Tank" visible="false"
            font="font:MediumBoldSystemFont" color="0xBFD9E2FF" />
        <RadioButtonList id="tank" translation="[160,248]" itemSize="[1100,57]" itemSpacing="[0,4]"
            vertFocusAnimationStyle="floatingFocus" visible="false" />
        <Label id="lightingLabel" translation="[160,202]" text="Lighting"
            font="font:MediumBoldSystemFont" color="0xBFD9E2FF" />
        <RadioButtonList id="lighting" translation="[160,248]" itemSize="[1100,57]" itemSpacing="[0,4]"
            vertFocusAnimationStyle="floatingFocus" />
        <Label id="seasonLabel" translation="[160,575]" text="Season"
            font="font:MediumBoldSystemFont" color="0xBFD9E2FF" />
        <RadioButtonList id="season" translation="[160,621]" itemSize="[1100,57]" itemSpacing="[0,4]"
            vertFocusAnimationStyle="floatingFocus" />
    </children>
</component>
